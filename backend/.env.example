# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/servicedesk_pro

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRE=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Google AI Studio (Gemini) key - https://aistudio.google.com/apikey
# Paste your key below. If left blank, the built-in local AI engine is used.
GEMINI_API_KEY=
# Optional: override the model (default tries gemini-flash-latest, then gemini-2.5-flash)
GEMINI_MODEL=
